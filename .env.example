# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
AFFILIATE_API_KEY=
LEAD_FUNNEL=profitsolutions
LEAD_COUNTRY=IT
# Set to 1 only when running behind Cloudflare (uses CF-Connecting-IP for the lead IP)
TRUST_CLOUDFLARE=0
# Optional comma-separated extra hosts allowed for the autologin redirect (Supabase host is always allowed)
AUTOLOGIN_ALLOWED_HOSTS=
